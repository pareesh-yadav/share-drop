# ShareDrop — Environment Variables

# ─── Signaling ────────────────────────────────────────────────────────────────
# WebSocket URL for the signaling server
# If not set, the app uses LocalSignalingTransport (BroadcastChannel, same browser only)
VITE_SIGNALING_URL=

# Set to "true" to force local BroadcastChannel mode (development only)
VITE_USE_LOCAL_SIGNALING=false

# ─── App ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME=ShareDrop

# ─── WebRTC ICE Servers ───────────────────────────────────────────────────────
# Comma-separated STUN server URLs (defaults to Google's public STUN servers)
VITE_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN server configuration (JSON array of RTCIceServer objects)
# WARNING: Do NOT put TURN credentials here for production.
#   TURN credentials should be generated server-side via a Netlify Function.
#   These vars are ONLY for development/testing.
# Example: [{"urls":["turn:turn.example.com:3478"],"username":"user","credential":"pass"}]
VITE_TURN_SERVERS=

# ─── Demo Mode ────────────────────────────────────────────────────────────────
# Set to "true" to enable demo/simulation mode for portfolio presentations
VITE_DEMO_MODE=false
